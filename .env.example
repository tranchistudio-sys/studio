DATABASE_URL=
PORT=3000
NODE_ENV=development
LOCAL_OBJECT_STORAGE_DIR=

# ─── PLATFORM AUTH / MULTI-TENANT FOUNDATION ────────────────────────────────
# Database điều khiển riêng. Tuyệt đối không dùng cùng database với DATABASE_URL.
PLATFORM_DATABASE_URL=
# Reference tới đúng database nghiệp vụ Amazing Studio hiện tại; không copy dữ liệu.
DEFAULT_TENANT_DATABASE_URL=
# Mỗi studio mới dùng một secret env riêng được registry tham chiếu bằng `env:...`.
# TENANT_STUDIO_B_DATABASE_URL=
# Opaque server session + legacy bridge ký nội bộ. Dùng chuỗi ngẫu nhiên >= 32 bytes.
SESSION_SECRET=
# 365 ngày: áp dụng chung cho đăng nhập mật khẩu và Google.
PLATFORM_SESSION_TTL_HOURS=8760
PLATFORM_DB_POOL_MAX=10

# PR2 tenant router: pool được giới hạn toàn cục và theo từng studio.
TENANT_DB_MAX_POOLS=20
TENANT_DB_POOL_MAX=6
TENANT_DB_IDLE_TIMEOUT_MS=30000
TENANT_DB_CONNECT_TIMEOUT_MS=5000

# Public API không có session phải được server ánh xạ rõ về studio.
# Production nhiều domain: host=slug, phân cách bằng dấu phẩy.
PUBLIC_TENANT_HOST_MAP=
# Chỉ dùng cho môi trường một domain/studio (dev, staging cố định).
PUBLIC_TENANT_SLUG=amazing-studio
# Các luồng compatibility trước business guard luôn bind rõ tenant này.
LEGACY_LOGIN_TENANT_SLUG=amazing-studio
MCP_TENANT_SLUG=amazing-studio
STARTUP_TENANT_SLUG=amazing-studio

# Google Identity Services (Web client ID; không cần client secret cho login).
GOOGLE_CLIENT_ID=
# Chủ hệ thống được bootstrap đúng một lần. Không hard-code email trong source.
BOOTSTRAP_OWNER_EMAIL=
# ID staff admin hiện hữu cần liên kết OWNER; nên đặt rõ nếu có nhiều admin.
BOOTSTRAP_TENANT_STAFF_ID=

# Provisioning engine. Worker fail-closed unless APP_ENV=staging and both DB URLs
# use an exact hostname in TENANT_PROVISIONING_HOST_ALLOWLIST.
APP_ENV=development
ENABLE_TENANT_PROVISIONING_WORKER=0
TENANT_PROVISIONING_ADMIN_URL=
TENANT_PROVISIONING_TEMPLATE_DATABASE=
TENANT_PROVISIONING_HOST_ALLOWLIST=
TENANT_SECRET_MASTER_KEY=
TENANT_PROVISIONING_POLL_MS=5000

# Production CORS: danh sách origin chính xác, phân cách bằng dấu phẩy.
PUBLIC_APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=1

# Google Drive AutoPost dùng OAuth client riêng, không dùng GOOGLE_CLIENT_ID của login.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Facebook Messenger: bộ não ChatGPT/OpenAI cũ. false = tắt (mặc định), 1/true = bật.
FB_VERIFY_TOKEN=
# Bắt buộc để xác minh X-Hub-Signature-256 trước khi xử lý webhook POST.
FACEBOOK_APP_SECRET=
LEGACY_FB_BOT_ENABLED=false

# Claude (bộ não sale mới) — Giai đoạn 1: tư vấn Messenger
CLAUDE_FB_BOT_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# URL website công khai để Hoa gửi link (bảng giá/bộ ảnh/concept) cho khách. VD: https://amazingstudio.vn
# PUBLIC_APP_URL=

# ─── AI PROVIDER FALLBACK (tổng đài AI dùng chung) ───────────────────────────
# Provider chính. claude (mặc định) | openai | gemini.
# Có thể đổi runtime trong AI Settings (lưu DB) — biến này chỉ là mặc định ban đầu.
AI_PROVIDER=claude
# Công tắc giữ provider cũ để rollback (mặc định false = không gọi nếu Claude đang chạy).
LEGACY_OPENAI_ENABLED=false
LEGACY_GEMINI_ENABLED=false

# OpenAI (dự phòng 1). Key đọc từ DB settings.openai_api_key → AI_INTEGRATIONS_OPENAI_API_KEY → OPENAI_API_KEY.
# OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# Model OpenAI khi fallback. Bỏ trống = tự đoán (gateway→gpt-5.2, OpenAI thật→gpt-4o-mini).
# OPENAI_FALLBACK_MODEL=
# Gemini (dự phòng 2 — để dành, chưa bật). Có key thì adapter mới chạy.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# Wedding wishes are delivered directly by email and are not persisted.
# RESEND_API_KEY=re_xxxxxxxxx
# WEDDING_EMAIL_FROM=Amazing Studio <loichuc@your-verified-domain.com>

# ─── ANALYTICS / ADS (để trống = provider tự tắt) ─────────────────────────
VITE_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=v23.0
VITE_GA_MEASUREMENT_ID=
VITE_GTM_ID=
VITE_CLARITY_PROJECT_ID=
VITE_ANALYTICS_DEBUG=false
